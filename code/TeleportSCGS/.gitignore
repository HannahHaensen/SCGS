# Ignore user-specific and temporary files
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore Binaries and Intermediate folders
Binaries/
Intermediate/
DerivedDataCache/
Saved/

# Ignore project-specific settings
Config/DefaultEditorPerProjectUserSettings.ini
Config/DefaultEditor.ini

# Ignore Unreal Engine-generated files
*.aps
*.ncb
*.log
*.pdb
*.obj
*.dat
*.ddc
*.dump
