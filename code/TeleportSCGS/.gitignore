*.sdf
Build/

# Ignore compiled binaries
*.dll
*.exe
*.lib
*.app
*.dylib
*.so
*.a
*.cso
*.pdb
*.zip

# Ignore auto-generated asset files
*.generated.h
*.generated.cpp

# Ignore the .vs folder for Visual Studio projects
.vs/

# Ignore UAsset and UMap files (optional, if storing source assets only)
# Content/**/*.uasset
# Content/**/*.umap

# Ignore macOS system files
.DS_Store

# Ignore Windows system files
Thumbs.db
Desktop.ini

